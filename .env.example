# 이 파일을 .env로 복사해서 값을 채운다: cp .env.example .env
# .env는 비밀번호가 들어 있어서 저장소에 올리지 않는다(.gitignore)

# 서버 주소(DuckDNS에서 만든 이름). Caddy가 이 이름으로 HTTPS 인증서를 받는다
DOMAIN=teumta.duckdns.org

# PostgreSQL 계정. 처음 띄울 때 이 값으로 DB가 만들어진다(나중에 바꾸려면 DB도 바꿔야 한다)
DATABASE_USERNAME=teumta
DATABASE_PASSWORD=change-me

# 로그인 토큰(JWT) 서명 키. 아래 명령으로 만든 값을 넣는다(32바이트 이상). 바꾸면 모든 회원이 다시 로그인한다
#   openssl rand -base64 32
JWT_SECRET=change-me
